VITE_ANTHROPIC_API_KEY=your_api_key_here

# ── Google Earth Engine (GEE) ──────────────────────────────────────────────
# Option 1: Service Account JSON key file path (recommended for server)
GEE_KEY_PATH=./private-key.json

# Option 2: Application Default Credentials
# Run: gcloud auth application-default login
# (No env var needed — GEE detects it automatically)

PORT=3001
